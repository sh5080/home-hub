#pragma once
#include <stdint.h>

// ESP32 joins 2.4 GHz networks only.
static const char *WIFI_SSID = "";
static const char *WIFI_PASS = "";

// The hub running home-hub: its embedded MQTT broker (configs/devices.yaml
// mqtt.listen, default :1883). Must be a fixed address the bridge can reach —
// give the hub a DHCP reservation, or re-flash when its IP changes.
static const char *MQTT_HOST = "192.168.0.10";
static const uint16_t MQTT_PORT = 1883;
static const char *MQTT_USER = "";                 // "" if anonymous
static const char *MQTT_PASS = "";
